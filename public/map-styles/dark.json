{
  "version": 8,
  "name": "WT Dark OSM Raster",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": [
        "https://tile.openstreetmap.de/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 19
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0b1520" } },
    { "id": "osm", "type": "raster", "source": "osm", "minzoom": 0, "maxzoom": 20, "paint": { "raster-brightness-min": 0.05, "raster-saturation": -0.35, "raster-contrast": 0.1 } }
  ]
}

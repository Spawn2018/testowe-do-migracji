<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Watch Tower — bramka SMS"
      android:textSize="20sp"
      android:textStyle="bold"
      android:paddingBottom="8dp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Token, URL i klucz anon tylko na tym telefonie. Nigdy nie wklejaj ich do czatu ani repozytorium."
      android:paddingBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="URL projektu Supabase">
      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="Klucz anon (publiczny)"
      android:layout_marginTop="8dp">
      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputAnon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="Token parowania (jednorazowy z Opcji)"
      android:layout_marginTop="8dp">
      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="Numer SIM bramki (E.164, np. +4670…)"
      android:layout_marginTop="8dp">
      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="phone"
        android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
      android:id="@+id/btnSave"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="Zapisz ustawienia" />

    <Button
      android:id="@+id/btnStart"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Uruchom bramkę" />

    <Button
      android:id="@+id/btnStop"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Zatrzymaj" />

    <Button
      android:id="@+id/btnBattery"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Wyłącz oszczędzanie baterii" />

    <Button
      android:id="@+id/btnVendor"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Autostart Realme / nigdy nie usypiaj" />

    <TextView
      android:id="@+id/status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textIsSelectable="true"
      android:text="Status: zatrzymana" />

    <TextView
      android:id="@+id/vendorHint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textSize="13sp"
      android:lineSpacingMultiplier="1.15"
      android:textIsSelectable="true" />
  </LinearLayout>
</ScrollView>

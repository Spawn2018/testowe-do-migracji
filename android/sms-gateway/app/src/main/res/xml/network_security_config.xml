<?xml version="1.0" encoding="utf-8"?>
<!-- Tylko systemowe CA. Cleartext wyłączony. Bez user-CA i bez trust-all. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
